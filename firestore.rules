rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 認証済みユーザーは全コレクション読み取り可能
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // castings: 認証済みユーザーは読み書き可能
    match /castings/{castingId} {
      allow read, write: if request.auth != null;
    }

    // casts: 認証済みユーザーは読み書き可能
    match /casts/{castId} {
      allow read, write: if request.auth != null;
    }

    // admins: 認証済みユーザーは読み書き可能（管理画面はUI側で管理者のみアクセス制限）
    match /admin/{adminId} {
      allow read, write: if request.auth != null;
    }

    // castMaster: 認証済みユーザーは読み書き可能
    match /castMaster/{docId} {
      allow read, write: if request.auth != null;
    }

    // shootingContacts: 認証済みユーザーは読み書き可能
    match /shootingContacts/{docId} {
      allow read, write: if request.auth != null;
    }

    // shootings: 認証済みユーザーは読み書き可能
    // NOTE: GAS (gokko-sam) もメイキング URL / Drive リンク / 香盤シートリンクの更新で書き込む。
    //       ハイフン無し ID で書き込まれると重複の原因になるので、
    //       GAS 側を「ハイフン付き notionPageId をそのまま docId に」修正してもらう必要あり。
    match /shootings/{docId} {
      allow read, write: if request.auth != null;
    }

    // shootingDetails: 認証済みユーザーは読み書き可能
    match /shootingDetails/{docId} {
      allow read, write: if request.auth != null;
    }

    // config: 認証済みユーザーは読み取り可能
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // offshotDrive: 認証済みユーザーは読み書き可能
    match /offshotDrive/{docId} {
      allow read, write: if request.auth != null;
    }

    // staffMentions: 認証済みユーザーは読み書き可能（管理画面のみ操作）
    match /staffMentions/{docId} {
      allow read, write: if request.auth != null;
    }

    // galaRates: 俳優ギャラ換算表。認証済みユーザーは読み書き可能（管理画面のみ操作）
    match /galaRates/{docId} {
      allow read, write: if request.auth != null;
    }

    // shoots: 香盤。撮影1件 = Notion の撮影ページID。
    // 本体（payload）と、その下の versions / roster / staff / props。
    // CLI（kouban-cli サービスアカウント）と アプリの両方が書く。
    match /shoots/{shootId} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // works: 作品に付くもの（役・小道具）。撮影をまたいで貯める
    match /works/{workId} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // koubanExports: Casty へ送った履歴と照合の結果
    match /koubanExports/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
